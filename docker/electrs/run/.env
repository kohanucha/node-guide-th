# User ID และ Group ID (ปกติคือ 1000)
UID=1000
GID=1000

# รายละเอียด Image (ควรตรงกับที่ Build ไว้ในขั้นตอนที่ 1)
ELECTRS_IMAGE_NAME=local/electrs
ELECTRS_VERSION=master

# การตั้งค่าพื้นฐาน
ELECTRS_LOG_FILTERS=INFO
ELECTRS_NETWORK=bitcoin

# โฟลเดอร์เก็บ Database ของ Electrs บนเครื่องหลัก (แนะนำเป็น SSD)
ELECTRS_HOST_DB_DIR=

# โฟลเดอร์เก็บข้อมูลบล็อกเชนของ Bitcoin Node บนเครื่องหลัก
ELECTRS_HOST_DAEMON_DIR=

# ไอพีและพอร์ตสำหรับเชื่อมต่อ Bitcoin Node RPC
ELECTRS_DAEMON_RPC_ADDR=127.0.0.1:8332

# ไอพีและพอร์ตสำหรับเชื่อมต่อ Bitcoin Node P2P
ELECTRS_DAEMON_P2P_ADDR=127.0.0.1:8333

# พอร์ตสำหรับให้ Wallet เชื่อมต่อเข้าหา Electrs (ปกติคือ 50001)
ELECTRS_ELECTRUM_RPC_ADDR=0.0.0.0:50001

# Path ภายใน Container (ไม่ต้องแก้ไข)
ELECTRS_DB_DIR=/home/electrs/electrs/db
ELECTRS_DAEMON_DIR=/home/electrs/electrs/bitcoin
